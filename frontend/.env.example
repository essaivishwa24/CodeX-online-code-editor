# Leave empty to use Vite's /api development or preview proxy (backend: http://127.0.0.1:8010).
# For a separately hosted backend, set its full origin, for example http://127.0.0.1:8010.
VITE_API_BASE_URL=

# Client-side request deadline in milliseconds. The backend also enforces its own timeout.
VITE_API_TIMEOUT_MS=20000
